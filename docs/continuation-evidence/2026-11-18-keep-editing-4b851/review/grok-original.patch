+test("actual Keep editing does not steal intentional focus or cross a closed, replaced, or removed dialog", () => {
+  for (const next of ["editor", "outside", "closed", "removed"]) {
+    const h = keepFocusHarness("cancel");
+    h.activate(); h.disconnect(h.keepButton);
+    if (next === "editor") h.document.activeElement = h.notes;
+    else if (next === "outside") h.document.activeElement = h.outside;
+    else if (next === "closed") h.dialog.open = false;
+    else h.dialog.isConnected = false;
+    const active = h.document.activeElement;
+    h.flush();
+    assert.equal(h.document.activeElement, active, next);
+    assert.equal(h.focusCalls.length, 0, next);
+    assert.equal(h.state.dialogDirty, true); assert.equal(h.state.editorDraft.note, "متابعة خاصة");
