+function keepFocusHarness(opener) {
+  const frames = [], focusCalls = [];
+  const document = { activeElement: null, body: null, documentElement: null, queried: 0 };
+  class FocusTarget {
+    constructor(name) { this.name = name; this.isConnected = true; this.focusable = true; this.ownerDocument = document; this.dialog = null; }
+    closest(selector) { assert.equal(selector, "dialog"); return this.dialog; }
+    focus(options) { focusCalls.push({ target: this, options }); if (this.isConnected && this.focusable) { document.activeElement = this; this.onFocus?.(); } }
+  }
+  const body = new FocusTarget("body"), html = new FocusTarget("html"), heading = new FocusTarget("page heading"), cancel = new FocusTarget("Cancel"), deleteButton = new FocusTarget("Delete this private record"), stage = new FocusTarget("Stage"), notes = new FocusTarget("Private notes"), keep = new FocusTarget("Keep editing"), outside = new FocusTarget("outside control");
+  const dialog = {
+    open: true, isConnected: true,
+    descendants: new Set([cancel, deleteButton, stage, notes, keep]),
+    contains(target) { return target === dialog || this.descendants.has(target); },
+    querySelector(selector) { document.queried++; assert.equal(selector, "fieldset select, fieldset textarea, fieldset input:not([type='hidden'])"); return stage.isConnected ? stage : null; },
+  };
+  for (const node of [cancel, deleteButton, stage, notes, keep]) node.dialog = dialog;
+  document.body = body; document.documentElement = html; document.activeElement = keep;
+  const draft = { note: "متابعة خاصة", stage: "interview" };
+  const state = { confirm: true, dialogDirty: true, editorDraft: draft, dialogKind: "record" };
+  const discardReturn = { current: opener === "delete" ? deleteButton : opener === "none" ? null : cancel };
+  const context = vm.createContext({
+    discardReturn, HTMLElement: FocusTarget, document,
+    requestAnimationFrame(callback) { frames.push(callback); return frames.length; },
+    setConfirmDialogDiscard(value) { assert.equal(value, false); state.confirm = false; },
+    setDialog() { throw new Error("Keep editing must leave the open dialog and its draft alone"); },
+    setDialogDirty() { throw new Error("Keep editing must not change the dirty flag"); },
+    setEditorDraft() { throw new Error("Keep editing must not change the draft"); },
+  });
+  install(context, "keepEditing");
+  const disconnect = target => { target.isConnected = false; dialog.descendants.delete(target); if (document.activeElement === target) document.activeElement = body; };
+  const flush = () => { assert.equal(frames.length, 1); frames.shift()(0); assert.equal(frames.length, 0); };
+  return { document, body, heading, cancel, deleteButton, stage, notes, keepButton: keep, outside, dialog, discardReturn, state, draft, focusCalls, disconnect, flush, activate: () => context.keepEditing({ currentTarget: keep }) };
