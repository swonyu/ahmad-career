+test("actual Keep editing returns focus to the preserved record control after its alert is removed", () => {
+  assert.equal(buttonClick("Keep editing"), "keepEditing");
+  assert.doesNotMatch(declaration("keepEditing"), /recoverPhoneFocus|phone-page-heading/);
+  const h = keepFocusHarness("cancel");
+  h.activate();
+  assert.equal(h.state.confirm, false);
+  assert.equal(h.document.activeElement, h.keepButton, "Focus waits until the alert control is actually gone");
+  assert.equal(h.state.dialogDirty, true); assert.equal(h.state.editorDraft, h.draft); assert.equal(h.state.dialogKind, "record");
+  h.disconnect(h.keepButton); h.flush();
+  assert.equal(h.document.activeElement, h.cancel);
+  assert.deepEqual(h.focusCalls.map(call => call.target), [h.cancel]);
+  assert.equal(h.focusCalls[0].options.preventScroll, true);
+  assert.equal(h.document.queried, 0, "A usable opener inside the dialog does not fall through to another control");
+  assert.equal(h.focusCalls.some(call => call.target === h.heading), false);
