+test("actual Keep editing uses the delete opener or the editor control, never the page heading", () => {
+  const deleted = keepFocusHarness("delete");
+  deleted.activate(); deleted.disconnect(deleted.keepButton); deleted.flush();
+  assert.equal(deleted.document.activeElement, deleted.deleteButton);
+  assert.equal(deleted.focusCalls.some(call => call.target === deleted.heading), false);
+  const fallback = keepFocusHarness("cancel");
+  fallback.disconnect(fallback.cancel); fallback.document.activeElement = fallback.dialog;
+  fallback.activate(); fallback.disconnect(fallback.keepButton); fallback.flush();
+  assert.equal(fallback.document.activeElement, fallback.stage, "Body or dialog-root focus is restored to the editor");
+  assert.equal(fallback.focusCalls.some(call => call.target === fallback.heading), false);
+  const nowhere = keepFocusHarness("none");
+  nowhere.disconnect(nowhere.stage); nowhere.activate(); nowhere.disconnect(nowhere.keepButton); nowhere.flush();
+  assert.equal(nowhere.document.activeElement, nowhere.body);
+  assert.equal(nowhere.focusCalls.length, 0);
+});
